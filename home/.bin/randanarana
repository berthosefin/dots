#!/usr/bin/env bash
set -euo pipefail

DEFAULT_LENGTH=8
LENGTH=$DEFAULT_LENGTH
PREFIX=""
SUFFIX=""
RECURSIVE=0
RENAME_DIRS=0
DRY_RUN=0
INTERACTIVE=0
FORCE=0
TARGET=""

RENAMED=0
FAILED=0

usage() {
  cat <<EOF
Usage: $0 [OPTIONS] <DIRECTORY>

Rename the files in a directory with random names (a-zA-Z0-9)
of a common length, keeping the original extension.

Paths are shown relative to the target directory. Items whose name
already matches the random pattern are skipped (use --force to rename
them anyway).

Options:
  -l, --length N     Length of the random part (default: $DEFAULT_LENGTH)
  -p, --prefix P     Prefix added to the name (e.g. img_)
  -s, --suffix S     Suffix added to the name (e.g. _2026)
  -r, --recursive    Also process files in subdirectories
                     (subdirectory names are kept)
  -D, --dirs         Also rename the subdirectories (implies --recursive)
  -i, --interactive  Confirm each item (y=yes, N=no, a=yes to all, q=quit)
  -f, --force        Rename items that already match the random pattern
  -n, --dry-run      Show the preview only, without renaming
  -h, --help         Show this help

Examples:
  $0 /path/to/directory
  $0 -l 12 -p img_ -s _backup /path/to/directory
  $0 -r -i /path/to/directory
EOF
}

die() {
  echo "Error: $*" >&2
  exit 1
}

random_string() {
  local n=$1 out="" i
  local chars='abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789'
  for ((i = 0; i < n; i++)); do
    out+="${chars:RANDOM % ${#chars}:1}"
  done
  printf '%s' "$out"
}

split_ext() {
  local name=$1
  if [[ "$name" == *.* ]]; then
    printf '.%s' "${name##*.}"
  fi
}

# Return 0 if the item already matches "prefix + alnum(LENGTH) + suffix [+ ext]"
matches_pattern() {
  local full=$1 is_dir=$2
  local bare=$full
  if [[ "$is_dir" != 1 && "$full" == *.* ]]; then
    bare="${full%.*}"
  fi
  if [[ -n "$PREFIX" ]]; then
    [[ "$bare" == "$PREFIX"* ]] || return 1
    bare="${bare#$PREFIX}"
  fi
  if [[ -n "$SUFFIX" ]]; then
    [[ "$bare" == *"$SUFFIX" ]] || return 1
    bare="${bare%$SUFFIX}"
  fi
  [[ "$bare" =~ ^[a-zA-Z0-9]+$ ]] || return 1
  [[ "${#bare}" -eq "$LENGTH" ]] || return 1
  return 0
}

# Show a path relative to the target directory
display_path() {
  printf '%s' "${1#"$TARGET"/}"
}

declare -A USED_NAMES=()

# Reserve the original names so generated names never collide with them
seed_names() {
  local f
  for f in "$@"; do
    USED_NAMES["$(basename "$f")"]=1
  done
}

generate_names() {
  local f base dirbase new
  local names=()
  for f in "$@"; do
    base=$(basename "$f")
    dirbase=$(dirname "$f")
    # Regenerate until the name is unique
    while true; do
      new="${PREFIX}$(random_string "$LENGTH")${SUFFIX}$(split_ext "$base")"
      [[ -z "${USED_NAMES[$new]:-}" ]] && break
    done
    USED_NAMES["$new"]=1
    names+=("$dirbase/$new")
  done
  printf '%s\n' "${names[@]}"
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -l | --length)
      [[ $# -ge 2 ]] || die "$1 requires a value"
      LENGTH="$2"
      shift 2
      ;;
    -p | --prefix)
      [[ $# -ge 2 ]] || die "$1 requires a value"
      PREFIX="$2"
      shift 2
      ;;
    -s | --suffix)
      [[ $# -ge 2 ]] || die "$1 requires a value"
      SUFFIX="$2"
      shift 2
      ;;
    -r | --recursive)
      RECURSIVE=1
      shift
      ;;
    -D | --dirs)
      RENAME_DIRS=1
      RECURSIVE=1
      shift
      ;;
    -i | --interactive)
      INTERACTIVE=1
      shift
      ;;
    -f | --force)
      FORCE=1
      shift
      ;;
    -n | --dry-run)
      DRY_RUN=1
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    -*)
      die "Unknown option: $1 (see --help)"
      ;;
    *)
      [[ -n "$TARGET" ]] && die "Only one directory expected: $TARGET"
      TARGET="$1"
      shift
      ;;
  esac
done

[[ -n "$TARGET" ]] || die "Missing directory (see --help)"
[[ -d "$TARGET" ]] || die "Not a directory: $TARGET"
[[ "$LENGTH" =~ ^[0-9]+$ ]] && [[ "$LENGTH" -gt 0 ]] || die "Invalid length: $LENGTH"

# Resolve the target to an absolute path
TARGET="$(cd "$TARGET" && pwd)"

# Collect files (hidden files and directories are skipped, alphabetical order)
files_all=()
while IFS= read -r -d '' f; do
  files_all+=("$f")
done < <(
  if [[ "$RECURSIVE" == 1 ]]; then
    find "$TARGET" -mindepth 1 \( -type d -name '.*' \) -prune -o -type f ! -name '.*' -print0 | sort -z
  else
    find "$TARGET" -mindepth 1 -maxdepth 1 -type f ! -name '.*' -print0 | sort -z
  fi
)

# Collect subdirectories bottom-up (deepest first) for the --dirs mode
dirs_all=()
if [[ "$RENAME_DIRS" == 1 ]]; then
  while IFS= read -r -d '' d; do
    dirs_all+=("$d")
  done < <(find "$TARGET" -mindepth 1 -type d ! -name '.*' -depth -print0)
fi

# Partition items: already-random names are skipped unless --force
files_do=()
files_skip=()
for f in "${files_all[@]}"; do
  if [[ "$FORCE" == 1 ]] || ! matches_pattern "$(basename "$f")" 0; then
    files_do+=("$f")
  else
    files_skip+=("$f")
  fi
done
dirs_do=()
dirs_skip=()
for d in "${dirs_all[@]}"; do
  if [[ "$FORCE" == 1 ]] || ! matches_pattern "$(basename "$d")" 1; then
    dirs_do+=("$d")
  else
    dirs_skip+=("$d")
  fi
done

PRESKIPPED=$(( ${#files_skip[@]} + ${#dirs_skip[@]} ))
RENAME_TOTAL=$(( ${#files_do[@]} + ${#dirs_do[@]} ))

# Reserve original names, then generate the final names for the items to rename
seed_names "${files_all[@]}" "${dirs_all[@]}"
mapfile -t file_names < <(generate_names "${files_do[@]}")
mapfile -t dir_names < <(generate_names "${dirs_do[@]}")

show_preview() {
  echo "Target: $TARGET"
  echo "Items to rename ($RENAME_TOTAL):"
  for i in "${!files_do[@]}"; do
    echo "  $(display_path "${files_do[$i]}") -> $(display_path "${file_names[$i]}")"
  done
  for i in "${!dirs_do[@]}"; do
    echo "  $(display_path "${dirs_do[$i]}") -> $(display_path "${dir_names[$i]}")"
  done
  if [[ "$PRESKIPPED" -gt 0 ]]; then
    echo "$PRESKIPPED already-random item(s) skipped (use --force to rename them)."
  fi
}

summary() {
  local skipped=$(( PRESKIPPED + RENAME_TOTAL - RENAMED - FAILED ))
  echo ""
  echo "Done: $RENAMED renamed, $skipped skipped, $FAILED failed."
}

interrupted() {
  echo ""
  summary
  exit 130
}

# --dry-run: review only
if [[ "$DRY_RUN" == 1 ]]; then
  if [[ "$RENAME_TOTAL" -eq 0 ]]; then
    if [[ "$PRESKIPPED" -gt 0 ]]; then
      echo "No items to rename ($PRESKIPPED already random, use --force to rename them)."
    else
      echo "No items to rename."
    fi
  else
    show_preview
  fi
  exit 0
fi

if [[ "$RENAME_TOTAL" -eq 0 ]]; then
  if [[ "$PRESKIPPED" -gt 0 ]]; then
    echo "No items to rename ($PRESKIPPED already random, use --force to rename them)."
  else
    echo "No items to rename."
  fi
  exit 0
fi

rename_item() {
  local src=$1 dst=$2
  if mv "$src" "$dst"; then
    ((RENAMED += 1))
  else
    ((FAILED += 1))
    echo "  Error: could not rename $(display_path "$src")" >&2
  fi
}

# Interactive mode: confirm each item, y/N/a/q, Ctrl+C to quit
if [[ "$INTERACTIVE" == 1 ]]; then
  trap 'interrupted' INT
  show_preview
  echo ""
  all=0
  quit=0
  k=0
  for i in "${!files_do[@]}"; do
    if [[ "$all" == 1 ]]; then
      rename_item "${files_do[$i]}" "${file_names[$i]}"
      continue
    fi
    ((k += 1))
    echo "  [$k/$RENAME_TOTAL]  $(display_path "${files_do[$i]}") -> $(display_path "${file_names[$i]}")"
    read -r -p "  Rename? [y/N/a/q] " ans || { quit=1; break; }
    case "$ans" in
      y | Y) rename_item "${files_do[$i]}" "${file_names[$i]}" ;;
      a | A) all=1; rename_item "${files_do[$i]}" "${file_names[$i]}" ;;
      q | Q) quit=1; break ;;
      *) : ;;
    esac
  done
  if [[ "$quit" == 0 ]]; then
    for i in "${!dirs_do[@]}"; do
      if [[ "$all" == 1 ]]; then
        rename_item "${dirs_do[$i]}" "${dir_names[$i]}"
        continue
      fi
      ((k += 1))
      echo "  [$k/$RENAME_TOTAL]  $(display_path "${dirs_do[$i]}") -> $(display_path "${dir_names[$i]}")"
      read -r -p "  Rename? [y/N/a/q] " ans || break
      case "$ans" in
        y | Y) rename_item "${dirs_do[$i]}" "${dir_names[$i]}" ;;
        a | A) all=1; rename_item "${dirs_do[$i]}" "${dir_names[$i]}" ;;
        q | Q) break ;;
        *) : ;;
      esac
    done
  fi
  summary
  exit 0
fi

# Default mode: preview then one global confirmation
show_preview
echo ""
read -r -p "Rename these $RENAME_TOTAL items? [y/N] " answer || exit 0
[[ "$answer" =~ ^[yY]([eE][sS])?$ ]] || { echo "Cancelled."; exit 0; }

trap 'interrupted' INT
for i in "${!files_do[@]}"; do
  rename_item "${files_do[$i]}" "${file_names[$i]}"
done
for i in "${!dirs_do[@]}"; do
  rename_item "${dirs_do[$i]}" "${dir_names[$i]}"
done
summary
